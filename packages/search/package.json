{
  "name": "@nordcraft/search",
  "description": "Used for searching and reporting linting problems in toddle projects.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/nordcraftengine/nordcraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordcraftengine/nordcraft.git",
    "directory": "packages/search"
  },
  "dependencies": {
    "@nordcraft/core": "workspace:*",
    "@nordcraft/schemas": "workspace:*",
    "@nordcraft/ssr": "workspace:*",
    "fast-deep-equal": "3.1.3",
    "jsondiffpatch": "0.7.6",
    "postcss": "8.5.26",
    "valibot": "1.5.0"
  },
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "npm-publish": "bun run build && bun publish --access public",
    "typecheck": "bun check",
    "watch": "tsgo -w",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:watch:only": "bun test --watch --only"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
