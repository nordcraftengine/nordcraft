{
  "name": "@nordcraft/runtime",
  "license": "Apache-2.0",
  "type": "module",
  "homepage": "https://github.com/nordcraftengine/nordcraft",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordcraftengine/nordcraft.git",
    "directory": "packages/runtime"
  },
  "dependencies": {
    "@nordcraft/core": "workspace:*",
    "@nordcraft/std-lib": "workspace:*",
    "fast-deep-equal": "3.1.3",
    "modern-screenshot": "4.7.0",
    "path-to-regexp": "6.3.0"
  },
  "scripts": {
    "build": "tsgo && bun scripts/build.js",
    "npm-publish": "bun run build && bun publish --access public",
    "typecheck": "bun check",
    "watch": "tsgo -w"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  }
}
